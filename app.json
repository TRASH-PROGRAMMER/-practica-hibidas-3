{
  "expo": {
    "name": "Solicitudes",
    "slug": "solicitudes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos seleccionar una foto para actualizar tu perfil.",
          "cameraPermission": "Necesitamos usar la cámara solo para tomar tu foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Necesitamos tu ubicación solo cuando pulses Obtener ubicación."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Necesitamos acceder al movimiento del dispositivo cuando actives el sensor."
        }
      ],
      "expo-notifications",
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ec.edu.ejemplo.solicitudes.equipo01",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "055c0583-c7e0-4e19-84b8-b869bf75ec7f"
      }
    },
    "owner": "ruddypaul"
  }
}
